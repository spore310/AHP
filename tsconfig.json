{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@env/*": ["./env/*"],
      "@env": ["./env/index.ts"],
      "@jsonrpc": ["./src/jsonrpc/index.ts"],
      "@jsonrpc/*": ["./src/jsonrpc/*"],
      "@sessions": ["./src/sessions/index.ts"],
      "@sessions/*": ["./src/sessions/*"],
      "@application": ["./src/application/index.ts"],
      "@application/*": ["./src/application/*"],
      "@tools": ["./src/tools/index.ts"],
      "@tools/*": ["./src/tools/*"],
      "@toolClient": ["./src/toolClient/index.ts"],
      "@toolClient/*": ["./src/toolClient/*"],
      "@websocket": ["./src/websocket/index.ts"],
      "@websocket/*": ["./src/websocket/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", "dist"]
}
