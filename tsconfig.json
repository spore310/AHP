{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@env/*": ["./env/*"],
      "@env": ["./env/index.ts"],
      "@jsonrpc": ["./src/jsonrpc/index.ts"],
      "@jsonrpc/*": ["./src/jsonrpc/*"],
      "@sessions": ["./src/sessions/index.ts"],
      "@sessions/*": ["./src/sessions/*"],
      "@application": ["./src/application/index.ts"],
      "@application/*": ["./src/application/*"],
      "@agents": ["./src/agents/index.ts"],
      "@agents/*": ["./src/agents/*"],
      "@authorization": ["./src/authorization/index.ts"],
      "@authorization/*": ["./src/authorization/*"],
      "@persistence": ["./src/persistence/index.ts"],
      "@persistence/*": ["./src/persistence/*"],
      "@work": ["./src/work/index.ts"],
      "@work/*": ["./src/work/*"],
      "@client": ["./src/client/index.ts"],
      "@client/*": ["./src/client/*"],
      "@client/transport": ["./src/client/helpers/transport/index.ts"],
      "@tool": ["./src/tool/index.ts"],
      "@tool/*": ["./src/tool/*"],
      "@tool/contracts": ["./src/tool/helpers/contracts/index.ts"],
      "@tool/protocol": ["./src/tool/helpers/protocol/index.ts"],
      "@tool/client": ["./src/tool/helpers/client/index.ts"],
      "@tool/execution": ["./src/tool/helpers/execution/index.ts"],
      "@tool/server": ["./src/tool/helpers/execution/helpers/server/index.ts"],
      "@tool/policy": ["./src/tool/helpers/policy/index.ts"],
      "@tool/policy/binding": ["./src/tool/helpers/policy/helpers/binding/index.ts"],
      "@authorization/policies": ["./src/authorization/helpers/policies/index.ts"],
      "@sessions/views": ["./src/sessions/helpers/views/index.ts"],
      "@jsonrpc/value": ["./src/jsonrpc/helpers/value/index.ts"],
      "@host": ["./src/host/index.ts"],
      "@host/*": ["./src/host/*"],
      "@websocket": ["./src/websocket/index.ts"],
      "@websocket/*": ["./src/websocket/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", "dist"]
}
