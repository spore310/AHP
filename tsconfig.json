{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@env/*": ["./env/*"],
      "@env": ["./env/index.ts"],
      "@jsonrpc": ["./src/jsonrpc/index.ts"],
      "@jsonrpc/*": ["./src/jsonrpc/*"],
      "@sessions": ["./src/sessions/index.ts"],
      "@sessions/*": ["./src/sessions/*"],
      "@application": ["./src/application/index.ts"],
      "@application/*": ["./src/application/*"],
      "@agents": ["./src/agents/index.ts"],
      "@agents/*": ["./src/agents/*"],
      "@authorization": ["./src/authorization/index.ts"],
      "@authorization/*": ["./src/authorization/*"],
      "@persistence": ["./src/persistence/index.ts"],
      "@persistence/*": ["./src/persistence/*"],
      "@work": ["./src/work/index.ts"],
      "@work/*": ["./src/work/*"],
      "@tools": ["./src/tools/index.ts"],
      "@tools/*": ["./src/tools/*"],
      "@toolPolicy": ["./src/toolPolicy/index.ts"],
      "@toolPolicy/*": ["./src/toolPolicy/*"],
      "@toolExecution": ["./src/toolExecution/index.ts"],
      "@toolExecution/client": ["./src/toolExecution/helpers/client/index.ts"],
      "@toolExecution/client/transport": ["./src/toolExecution/helpers/client/helpers/transport/index.ts"],
      "@toolExecution/*": ["./src/toolExecution/*"],
      "@toolClient": ["./src/toolClient/index.ts"],
      "@toolClient/*": ["./src/toolClient/*"],
      "@websocket": ["./src/websocket/index.ts"],
      "@websocket/*": ["./src/websocket/*"]
    }
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", "dist"]
}
