{
  "name": "agent-hosting-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x",
    "pnpm": "10.34.6"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "build": "vite build",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:check": "vite-node scripts/check-docs.ts",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run docs:check && pnpm run build"
  },
  "dependencies": {
    "@microsoft/agent-host-protocol": "1.0.0",
    "ajv": "8.20.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.9.1",
    "@types/ws": "8.18.2",
    "eslint": "10.11.0",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.4",
    "vite-node": "6.0.0",
    "vitest": "5.0.5"
  }
}
